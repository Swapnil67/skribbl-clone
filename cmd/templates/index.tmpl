<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scribbly - Drawing Game</title>
    <link rel="stylesheet" href="/static/css/game.css" />
  </head>

  <body>
    <!-- Decorative cartoon elements -->
    <div class="decor">
      <div class="blob one"></div>
      <div class="blob two"></div>
      <div class="blob three"></div>
      <div class="blob four"></div>

      <div class="star one">✦</div>
      <div class="star two">✦</div>
    </div>

    <main class="app">
      <!-- ================= HEADER ================= -->

      <header class="header panel">
        <div class="logo">
          <div class="logo-pencil">✏️</div>
          Scribbly<span>!</span>
        </div>

        <div class="header-right">
          <div class="round-pill">🎮 Round 3 / 8</div>

          <div class="timer" id="timer">⏱ <span>72</span>s</div>

          <button class="leave-btn">Leave</button>
        </div>
      </header>

      <!-- ================= PLAYERS ================= -->

      <aside class="players panel">
        <div class="section-heading">
          <h2>Players 👀</h2>
          <div class="count">5 / 8</div>
        </div>

        <div class="player active">
          <div class="crown">👑</div>

          <div class="avatar purple">A</div>

          <div class="player-details">
            <div class="player-name">Alex</div>

            <div class="player-status">✏️ Drawing...</div>
          </div>

          <div class="score">1240</div>
        </div>

        <div class="player">
          <div class="avatar pink">S</div>

          <div class="player-details">
            <div class="player-name">Sarah</div>

            <div class="player-status">🤔 Guessing</div>
          </div>

          <div class="score">980</div>
        </div>

        <div class="player">
          <div class="avatar blue">M</div>

          <div class="player-details">
            <div class="player-name">Mike</div>

            <div class="player-status">🤔 Guessing</div>
          </div>

          <div class="score">870</div>
        </div>

        <div class="player">
          <div class="avatar green">J</div>

          <div class="player-details">
            <div class="player-name">Jenny</div>

            <div class="player-status">💭 Thinking...</div>
          </div>

          <div class="score">720</div>
        </div>

        <div class="player">
          <div class="avatar orange">D</div>

          <div class="player-details">
            <div class="player-name">David</div>

            <div class="player-status">👀 Watching</div>
          </div>

          <div class="score">560</div>
        </div>
      </aside>

      <!-- ================= GAME ================= -->

      <section class="game">
        <div class="word-card panel">
          <div class="word-label">Alex is drawing...</div>

          <div class="word">
            <span class="hidden">_</span>
            <span class="hidden">_</span>
            A
            <span class="hidden">_</span>
            <span class="hidden">_</span>
          </div>
        </div>

        <div class="canvas-wrapper panel">
          <canvas id="canvas"></canvas>

          <div class="drawing-label">✏️ Alex's canvas</div>

          <div class="toolbar">
            <button class="tool active" id="brush" title="Brush">🖌️</button>

            <button class="tool" id="eraser" title="Eraser">🧽</button>

            <input
              class="color-picker"
              type="color"
              id="color"
              value="#25232b"
            />

            <input
              class="size"
              type="range"
              id="size"
              min="2"
              max="30"
              value="5"
            />

            <button class="tool" id="clear" title="Clear canvas">🗑️</button>
          </div>
        </div>
      </section>

      <!-- ================= CHAT ================= -->

      <aside class="chat panel">
        <div class="chat-header">
          <div class="chat-title">Chat 💬</div>

          <div class="online">
            <div class="online-dot"></div>
            5 online
          </div>
        </div>

        <div class="messages" id="messages">
          <div class="system-message">🎉 Game started! Have fun!</div>

          <div class="message">
            <div class="message-name" style="color: #ec4899">Sarah</div>

            <div class="bubble">Is it a spaceship? 🚀</div>
          </div>

          <div class="message">
            <div class="message-name" style="color: #0ea5e9">Mike</div>

            <div class="bubble">Maybe a rocket?</div>
          </div>

          <div class="message">
            <div class="message-name" style="color: #16a34a">Jenny</div>

            <div class="bubble">I think I know it 👀</div>
          </div>
        </div>

        <form class="chat-input" id="chatForm">
          <input
            id="chatInput"
            type="text"
            placeholder="Type your guess..."
            autocomplete="off"
          />

          <button class="send" type="submit">➤</button>
        </form>
      </aside>
    </main>
    <script src="/static/js/game.js"></script>
  </body>
</html>
